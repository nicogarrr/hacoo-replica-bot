# Token del bot de Telegram (de @BotFather). OBLIGATORIO.
TELEGRAM_BOT_TOKEN=
# IDs de Telegram autorizados, separados por comas.
AUTHORIZED_USER_IDS=8258546109,1484047314
# Canales publicos a indexar (sin @), separados por comas.
CHANNELS=hacoolinks,hacoolinksvip,hacoolinks10chanel,mkfashionfinds,iammmchannel,hacooenlacesdiarios,hacoofinds,hacoooofinds
# Minutos entre rastreos incrementales.
INDEX_INTERVAL_MIN=60
# Paginas (20 mensajes) maximo por canal y rastreo.
MAX_PAGES_PER_RUN=40
# Resolver shortlinks: 1=si, 0=no.
RESOLVE_LINKS=1
# Max shortlinks a resolver por minuto (guardarrailes).
RESOLVE_RATE_PER_MIN=60
# Vision por foto (LLM OpenAI-compatible). Sin clave, las fotos se rechazan
# con un mensaje de reserva.
OPENCODE_GO_API_KEY=
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
VISION_MODEL=deepseek-v4-flash-vision-exp
OPENCODE_GO_SESSION=hacoo-replica-bot
